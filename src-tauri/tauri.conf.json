{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIRust_MT",
  "version": "0.1.3",
  "identifier": "com.airust.mt",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIRust_MT",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' asset: http://asset.localhost https://asset.localhost data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost ws://localhost:1421",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Development",
    "shortDescription": "所见即所得 Markdown 编辑器",
    "longDescription": "AIRust_MT —— 使用 Rust 与 Tauri 2 重构的 MarkText：所见即所得 Markdown 编辑器，内置中文界面。",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": ["English", "SimpChinese", "Japanese", "Korean", "Russian", "Spanish", "French"],
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}